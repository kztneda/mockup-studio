{
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "const": "roles"
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "default": ""
          },
          "isSystem": {
            "type": "boolean",
            "default": false
          },
          "scope": {
            "description": "global = rol de la plataforma, fuera de cualquier tenant; tenant = rol dentro de un tenant",
            "type": "string",
            "enum": [
              "tenant",
              "global",
              "user"
            ]
          },
          "color": {
            "type": "string",
            "default": "#9c27b0"
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "resource": {
                  "type": "string",
                  "minLength": 1,
                  "description": "\"<modulo>\" o \"<modulo>.<entidad>\""
                },
                "actions": {
                  "type": "array",
                  "items": {
                    "description": "Acción de permiso. Ver CATALOG.md › PermissionAction.",
                    "anyOf": [
                      {
                        "type": "string",
                        "enum": [
                          "create",
                          "read",
                          "list",
                          "update",
                          "delete",
                          "restore",
                          "archive",
                          "export",
                          "import",
                          "approve",
                          "publish",
                          "cancel",
                          "assign",
                          "share",
                          "audit",
                          "manage"
                        ]
                      },
                      {
                        "type": "string",
                        "pattern": "^custom:.+"
                      }
                    ]
                  },
                  "default": []
                }
              },
              "required": [
                "resource"
              ],
              "additionalProperties": false
            },
            "default": []
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      },
      "default": []
    }
  },
  "required": [
    "kind"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SaaS Pack v2.0.0 · roles"
}
